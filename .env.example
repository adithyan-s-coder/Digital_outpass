# ================================================================
# Smart Outpass System - Environment Variables
# ================================================================

# --- OPTION 1: TiDB Cloud Serverless (RECOMMENDED FREE FOREVER) ---
# Sign up at https://tidbcloud.com (Free 5GB forever, no credit card needed)
# DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_USER=your_prefix.root
# DB_PASSWORD=your_tidb_password
# DB_NAME=test

# --- OPTION 2: Single Connection URL (TiDB, Aiven, Railway, etc.) ---
# DATABASE_URL=mysql://username:password@hostname:4000/dbname

# --- OPTION 3: Local MySQL (XAMPP / MySQL Server) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=outpass_db

# Optional SSL Override:
# DB_SSL_DISABLED=false   # Set to 'true' to disable SSL if needed

# --- Application Security ---
SECRET_KEY=dev-secret-key-change-in-production

# --- Twilio Configuration for SMS Notifications (Optional) ---
TWILIO_ACCOUNT_SID=your_sid_here
TWILIO_AUTH_TOKEN=your_token_here
TWILIO_PHONE_NUMBER=your_twilio_number_here

# --- AI-Powered Report Generation (Optional - falls back seamlessly if omitted) ---
# Gemini API Key (get free key at https://aistudio.google.com/)
AI_API_KEY=your_gemini_or_openai_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# AI_PROVIDER=gemini  # gemini or openai

